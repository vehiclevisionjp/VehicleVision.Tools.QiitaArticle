{
  "name": "VehicleVision-Tools-QiitaArticle-MarkdownPreview",
  "displayName": "VehicleVision.Tools.QiitaArticle.MarkdownPreview",
  "license": "AGPL-3.0-only",
  "description": "VS Code の Markdown プレビューを Qiita 固有の構文（:::note, lang:filename, 数式等）に対応させる拡張機能",
  "version": "0.1.0",
  "publisher": "PMCCoLtdITSolutionDiv",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/vehiclevisionjp/VehicleVision.Tools.QiitaArticle"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:qiita.config.json",
    "workspaceContains:public/"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "./media/qiita-markdown.css"
    ]
  },
  "scripts": {
    "build": "run-s build:css build:js",
    "build:css": "sass --no-charset --no-source-map --style=expanded scss/qiita-markdown.scss media/qiita-markdown.css",
    "build:js": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "watch": "run-p watch:css watch:js",
    "watch:css": "sass --no-charset --no-source-map --style=expanded --watch scss/qiita-markdown.scss media/qiita-markdown.css",
    "watch:js": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "package": "npx @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.0.0",
    "@types/vscode": "~1.85.0",
    "esbuild": "^0.28.2",
    "markdown-it": "^14.3.2",
    "npm-run-all2": "^9.0.3",
    "sass": "^1.105.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
