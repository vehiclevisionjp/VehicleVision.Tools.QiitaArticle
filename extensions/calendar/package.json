{
  "name": "VehicleVision-Tools-QiitaArticle-Calendar",
  "displayName": "VehicleVision.Tools.QiitaArticle.Calendar",
  "description": "Qiita 記事の投稿スケジュールをカレンダー形式で管理する VS Code 拡張機能",
  "license": "AGPL-3.0-only",
  "version": "0.1.0",
  "publisher": "PMCCoLtdITSolutionDiv",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/vehiclevisionjp/VehicleVision.Tools.QiitaArticle"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:qiita.config.json",
    "workspaceContains:public/"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "articleCalendar.open",
        "title": "記事カレンダーを開く",
        "category": "Qiita"
      }
    ],
    "configuration": {
      "title": "Qiita 記事カレンダー",
      "properties": {
        "articleCalendar.autoOpen": {
          "type": "boolean",
          "default": true,
          "description": "ワークスペースを開いたときに自動的にカレンダーを表示する"
        },
        "articleCalendar.theme": {
          "type": "string",
          "enum": [
            "auto",
            "light",
            "dark"
          ],
          "enumDescriptions": [
            "VS Code のテーマに合わせる",
            "常にライト",
            "常にダーク"
          ],
          "default": "auto",
          "scope": "resource",
          "description": "カレンダーの配色。auto は VS Code のテーマ（ライト / ダーク / ハイコントラスト）に追従します。"
        },
        "articleCalendar.holidayCalendarId": {
          "type": "string",
          "default": "ja.japanese.official#holiday@group.v.calendar.google.com",
          "scope": "resource",
          "markdownDescription": "祝日の取得元となる Google カレンダーの ID、または公開 ICS の URL。既定は日本の祝日（`ja.japanese.official#holiday@group.v.calendar.google.com`）。他国の祝日などに変更できます（例: `en.usa#holiday@group.v.calendar.google.com`）。空にすると holidays-jp の API（日本の祝日）を使用します。カレンダーは公開されている必要があります。"
        }
      }
    }
  },
  "scripts": {
    "build": "run-s build:css build:js",
    "build:css": "sass --no-charset --no-source-map --style=expanded scss/style.scss media/style.css",
    "build:js": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "watch": "run-p watch:css watch:js",
    "watch:css": "sass --no-charset --no-source-map --style=expanded --watch scss/style.scss media/style.css",
    "watch:js": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "package": "npx @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "~1.85.0",
    "@vscode/codicons": "^0.0.46-24",
    "esbuild": "^0.28.2",
    "npm-run-all2": "^9.0.3",
    "sass": "^1.105.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
